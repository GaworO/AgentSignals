//@version=6
indicator("Tanja • closed 1m feed v1.1", overlay = true)

// Install independently on ES1!, MNQ1! and NQ1!, standard 1-minute candles, ETH.
// Create THREE alerts, each using "Any alert() function call".
// The private webhook URL belongs in the alert dialog, never in this script.
// This is a candle exporter, not a strategy or order-execution script.
// NQ is collection-only in service 2.3; the existing AI still uses ES/MNQ.
if not timeframe.isminutes or timeframe.multiplier != 1
    runtime.error("Tanja feed requires a 1-minute chart.")
if not chart.is_standard
    runtime.error("Use standard candles, not Heikin Ashi, Renko or other synthetic bars.")
if syminfo.root != "ES" and syminfo.root != "MNQ" and syminfo.root != "NQ"
    runtime.error("Use ES, NQ or MNQ. Each is stored separately; MES is unsupported.")

// CME futures use "regular" for ETH and "us_regular" for RTH.
if syminfo.session != "regular" and syminfo.session != "extended"
    runtime.error("Enable Electronic Trading Hours (ETH). RTH is not accepted.")

number(float value) =>
    str.tostring(value, "#.########")

if barstate.isrealtime and barstate.isconfirmed and not na(volume)
    string payload = '{"schema_version":1,"feed_version":"tanja-1m-v1","symbol":"' + syminfo.root + '","ticker":"' + syminfo.prefix + ':' + syminfo.ticker + '","timeframe":"1","session":"' + syminfo.session + '","standard":true,"confirmed":true,"bar_open_ms":' + str.tostring(time) + ',"bar_close_ms":' + str.tostring(time_close) + ',"sent_at_ms":' + str.tostring(timenow) + ',"open":' + number(open) + ',"high":' + number(high) + ',"low":' + number(low) + ',"close":' + number(close) + ',"volume":' + number(volume) + '}'
    alert(payload, alert.freq_once_per_bar_close)

plot(close, "Feed close", display = display.data_window)
