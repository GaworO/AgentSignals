# LOCAL REVIEW TEMPLATE. Does not activate or unblock broker execution.
# Target policy: Directional only; original A/B stays shadow.
EXEC_STRATEGY_POLICY=V3_ONLY
LIVE_EXECUTION_ENABLED=false
EXEC_KILL_SWITCH=true
AB_ENTRY_ARMED=0
AB_MANAGER_MODE=shadow
AUTO_SUBMIT=0
EXEC_MODE=off
AB_V3_MODE=SHADOW
AB_DIRECTIONAL_LIVE_LONG=0
AB_DIRECTIONAL_LIVE_SHORT=0
V3_ENTRY_ARMED=0
V3_EXIT_MODE=shadow
V3_EXIT_REAL_EXECUTION=false
V3_RUNNER_ENABLED=false
# To collect context in shadow after operator deployment:
# AI owner changes cannot reuse the previous strategy's cached permission.
# Existing API credential/model/source configuration remains necessary.
AB_AI_ENABLED=true
AB_AI_OWNER=AB_DIRECTIONAL
AB_AI_TRIGGER=SETUP
AB_AI_SETUP_MAX_AGE_SECONDS=120
V3_AI_REVIEW_REQUIRED=true
AB_AI_INTERVAL_MINUTES=60
AB_AI_MAX_CALLS_PER_DAY=12
# News/calendar and accounting checks remain unchanged.
# Quote collection is read-only; collective cannot authorize execution.
DIRECTIONAL_QUOTE_MONITOR_ENABLED=true
# An approved execution policy and verified quote provenance are still required.
# AB_AI_SETUP_MAX_AGE_SECONDS is an observation TTL, NOT an approved entry limit.
